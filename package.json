{
  "name": "stepmania99",
  "version": "1.0.0",
  "description": "Browser-based multiplayer rhythm game - battle royale style!",
  "type": "module",
  "scripts": {
    "dev": "npm run scan-songs && vite",
    "dev:server": "node server/index.js",
    "dev:all": "npm run scan-songs && concurrently \"npm run dev:server\" \"vite\"",
    "build": "npm run scan-songs && tsc && vite build",
    "preview": "vite preview",
    "scan-songs": "tsx scripts/generate-songs-manifest.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "app:build": "tsc && vite build && tsx scripts/build-app.ts",
    "app": "npm run app:build && electron .",
    "app:dist": "npm run app:build && electron-builder --mac dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sderosiaux/stepmania99.git"
  },
  "keywords": [
    "rhythm-game",
    "stepmania",
    "ddr",
    "game",
    "typescript",
    "multiplayer",
    "battle-royale"
  ],
  "author": "sderosiaux",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sderosiaux/stepmania99/issues"
  },
  "homepage": "https://github.com/sderosiaux/stepmania99#readme",
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.2.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "io.github.sderosiaux.stepmania99",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "category": "public.app-category.music-games",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "productName": "StepMania 99"
}
